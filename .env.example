# Database Connection (SQLite for local prototype)
DATABASE_URL="file:./dev.db"

# Session JWT Authentication Secret (32 characters minimum for HS256)
JWT_SECRET="ai-study-companion-super-secret-key-32-chars-minimum-prod"

# Node Environment
NODE_ENV="development"

# Optional: OpenAI API Key for Neural Embeddings & Live LLM Features
# If omitted, the application seamlessly runs on high-quality local deterministic fallbacks!
# OPENAI_API_KEY="sk-proj-..."

# Optional: AI Model Name (Default: gpt-4o-mini)
# AI_MODEL="gpt-4o-mini"
